table _Background
	lineageTag: a71d8364-43b9-48ea-b8a7-c99cd83f5539

	/// HTML chrome Pagina 1
	measure '_BG Pagina 1' =
			VAR vCli = FORMAT([Total Clientes],"#,##0","pt-BR")
			VAR mCli = [Clientes Ativos MoM %]
			VAR vRec = "R$ " & FORMAT(DIVIDE([Receita Total],1000000),"#,##0.0","pt-BR") & " mi"
			VAR mRec = [Receita MoM %]
			VAR vTic = "R$ " & FORMAT([Ticket Medio],"#,##0.00","pt-BR")
			VAR mTic = [Ticket MoM %]
			VAR mPed = [Pedidos MoM %]
			VAR vPed = FORMAT([Total Pedidos],"#,##0","pt-BR")
			VAR clsPed = IF(ABS(mPed)<0.01,"flat",IF(mPed>=0,"up","down"))
			VAR pillPed = IF(mPed>=0,"+","") & FORMAT(mPed,"0.0%","pt-BR") & " no m&#234;s"
			VAR pRis = [% Em Risco]
			VAR vRis = FORMAT(pRis,"0.0%","pt-BR")
			VAR fCli = (MAX(0.85,MIN(1.15,1+mCli))-0.85)/0.30*100
			VAR fRec = (MAX(0.85,MIN(1.15,1+mRec))-0.85)/0.30*100
			VAR fTic = (MAX(0.85,MIN(1.15,1+mTic))-0.85)/0.30*100
			VAR fRis = MIN(pRis,0.40)/0.40*100
			VAR clsCli = IF(ABS(mCli)<0.01,"flat",IF(mCli>=0,"up","down"))
			VAR clsRec = IF(ABS(mRec)<0.01,"flat",IF(mRec>=0,"up","down"))
			VAR clsTic = IF(ABS(mTic)<0.01,"flat",IF(mTic>=0,"up","down"))
			VAR clsRis = IF(pRis>0.2,"warn","up")
			VAR colCli = IF(mCli>=0,"#34D399","#E5484D")
			VAR colRec = IF(mRec>=0,"#34D399","#E5484D")
			VAR colTic = IF(mTic>=0,"#34D399","#E5484D")
			VAR colRis = IF(pRis>0.2,"#F2C94C","#34D399")
			VAR pillCli = IF(mCli>=0,"+","") & FORMAT(mCli,"0.0%","pt-BR") & " no m&#234;s"
			VAR pillRec = IF(mRec>=0,"+","") & FORMAT(mRec,"0.0%","pt-BR") & " no m&#234;s"
			VAR pillTic = IF(mTic>=0,"+","") & FORMAT(mTic,"0.0%","pt-BR") & " no m&#234;s"
			VAR pillRis = IF(pRis>0.2,"alto","saud&#225;vel")
			VAR kpiCli = "<div class=""kpi champions""><div class=""top""><div class=""label-row""><span class=""dot""></span><span class=""label"">Receita total</span></div></div><div class=""value"">" & vRec & "</div><div class=""spark"">" & [_Spark Receita] & "</div></div>"
			VAR kpiRec = "<div class=""kpi big-spenders""><div class=""top""><div class=""label-row""><span class=""dot""></span><span class=""label"">Pedidos</span></div></div><div class=""value"">" & vPed & "</div><div class=""spark"">" & [_Spark Pedidos] & "</div></div>"
			VAR kpiTic = "<div class=""kpi novos""><div class=""top""><div class=""label-row""><span class=""dot""></span><span class=""label"">Ticket m&#233;dio</span></div></div><div class=""value"">" & vTic & "</div><div class=""spark"">" & [_Spark Ticket] & "</div></div>"
			VAR kpiRis = "<div class=""kpi clientes""><div class=""top""><div class=""label-row""><span class=""dot""></span><span class=""label"">Clientes</span></div></div><div class=""value"">" & vCli & "</div><div class=""spark"">" & [_Spark Clientes] & "</div></div>"
			RETURN
			"<!DOCTYPE html>
			<html lang=""pt-BR"">
			<head>
			<meta charset=""UTF-8"">
			<title>Background P1 &#8212; Vis&#227;o Executiva (chrome)</title>
			<style>
			  :root {
			    --bg-base: #08090A;
			    --bg-elev-1: #0E0F11;
			    --bg-elev-2: #131418;
			    --bg-card: rgba(20, 22, 30, 0.85);
			    --bg-card-solid: #14151D;
			    --border: rgba(255, 255, 255, 0.06);
			    --border-hover: rgba(255, 255, 255, 0.14);
			    --border-strong: rgba(255, 255, 255, 0.10);
			    --text-1: #F4F4F5;
			    --text-2: #A1A1AA;
			    --text-3: #8B8B92;
			    --text-muted: #6B6B73;
			    --champions: #5E6AD2;
			    --big-spenders: #BF6FF8;
			    --novos: #F2C94C;
			    --em-risco: #E5484D;
			    --champions-soft: rgba(94, 106, 210, 0.12);
			    --big-spenders-soft: rgba(191, 111, 248, 0.12);
			    --novos-soft: rgba(242, 201, 76, 0.12);
			    --em-risco-soft: rgba(229, 72, 77, 0.12);
			  }
			
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  /* Anti user-agent: for&#231;a headings a herdar cor/peso/tamanho do contexto */
			  h1, h2, h3, h4, h5, h6 { color: inherit; font: inherit; }
			  html, body { width: 100%; height: 100%; overflow: hidden; }
			
			  body {
			    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
			    background: radial-gradient(900px 600px at 12% 8%, rgba(191,111,248,0.10), transparent 65%), radial-gradient(800px 550px at 88% 92%, rgba(94,106,210,0.09), transparent 65%), radial-gradient(700px 500px at 55% 45%, rgba(191,111,248,0.05), transparent 60%), var(--bg-base);
			    color: var(--text-1);
			    -webkit-font-smoothing: antialiased;
			    position: relative;
			  }
			
			  /* &#9472;&#9472;&#9472; Background aurora animada &#9472;&#9472;&#9472; */
			  .bg-mesh { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
			  /* Aurora leve: camada unica, so transform+opacity (compositor GPU, sem repaint) */
			  .bg-mesh::before { content: ''; position: absolute; inset: -20%; background: radial-gradient(700px 500px at 20% 15%, rgba(191,111,248,0.14), transparent 60%), radial-gradient(600px 450px at 80% 85%, rgba(94,106,210,0.12), transparent 60%); animation: aurora 26s ease-in-out infinite alternate; will-change: transform, opacity; }
			  @keyframes aurora { 0% { transform: translate3d(-2%, -1%, 0); opacity: 0.55; } 100% { transform: translate3d(2%, 2%, 0); opacity: 1; } }
			  .bg-mesh::after {
			    content: ''; position: absolute; inset: 0;
			    background: radial-gradient(ellipse at center, transparent 30%, rgba(8, 9, 10, 0.55) 100%);
			  }
			
			  /* &#9472;&#9472;&#9472; Layout &#8212; aspect-ratio deriva a altura da largura (robusto em qualquer 16:9) &#9472;&#9472;&#9472; */
			  .dashboard {
			    position: relative; z-index: 1;
			    width: 100%; aspect-ratio: 16 / 9;
			    display: grid;
			    grid-template-rows: 56px 1fr 22px;
			    padding: 10px 14px; gap: 8px;
			  }
			
			  /* &#9472;&#9472;&#9472; Topbar &#9472;&#9472;&#9472; */
			  .topbar {
			    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
			    gap: 20px; padding: 0 16px;
			    background: var(--bg-card);
			
			    border: 1px solid var(--border); border-radius: 12px;
			  }
			  .brand { display: flex; align-items: center; gap: 12px; }
			  .logo {
			    width: 34px; height: 34px; border-radius: 9px;
			    background: linear-gradient(135deg, var(--big-spenders), #9D54E5);
			    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
			  }
			  .logo::after {
			    content: ''; width: 11px; height: 11px;
			    background: var(--bg-base); border-radius: 2px; transform: rotate(45deg);
			  }
			  .brand h1 { font-size: 15px; font-weight: 600; letter-spacing: -0.2px; color: var(--text-1); line-height: 1; }
			  .brand .sub { font-size: 10px; color: var(--text-2); letter-spacing: 1.6px; font-weight: 600; margin-top: 2px; text-transform: uppercase; opacity: 0.85; line-height: 1; }
			
			  .tabs {
			    display: flex; gap: 3px; justify-self: center;
			    background: rgba(255, 255, 255, 0.03);
			    border: 1px solid var(--border);
			    padding: 4px; border-radius: 12px;
			  }
			  .tab {
			    padding: 7px 18px; border-radius: 7px;
			    font: 500 13px inherit; color: var(--text-2);
			    background: transparent; border: none;
			  }
			  .tab.active {
			    background: var(--bg-card-solid); color: var(--text-1);
			    border: 1px solid var(--border-strong);
			  }
			
			  .topbar-meta { display: flex; gap: 14px; }
			  .meta-pill { padding: 2px 12px; border-left: 1px solid var(--border); }
			  .meta-pill .label { font-size: 9px; color: var(--text-3); letter-spacing: 1.2px; font-weight: 600; text-transform: uppercase; }
			  .meta-pill .value { font-size: 12px; font-weight: 600; margin-top: 2px; font-variant-numeric: tabular-nums; letter-spacing: -0.1px; color: var(--text-1); }
			
			  /* &#9472;&#9472;&#9472; Page &#9472;&#9472;&#9472; */
			  .page { display: grid; grid-template-rows: auto 1fr; gap: 8px; min-height: 0; height: 100%; }
			
			  /* &#9472;&#9472;&#9472; KPIs &#8212; frames vazios (valor vem do visual PBI por cima) &#9472;&#9472;&#9472; */
			  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
			  .kpi {
			    background: var(--bg-card);
			
			    border: 1px solid var(--border);
			    border-radius: 12px;
			    padding: 10px 14px;
			    position: relative; min-height: 70px; overflow: hidden;
			  }
			  .kpi::before {
			    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
			    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
			  }
			  .kpi .label-row { display: flex; align-items: center; gap: 8px; }
			  .kpi .dot { width: 8px; height: 8px; border-radius: 50%; position: relative; }
			  .kpi .dot::after {
			    content: ''; position: absolute; inset: -3px;
			    border-radius: 50%; background: inherit;
			    opacity: 0.3; filter: blur(4px);
			    animation: dotPulse 3s ease-in-out infinite;
			  }
			  @keyframes dotPulse {
			    0%, 100% { opacity: 0.3; transform: scale(1); }
			    50% { opacity: 0.6; transform: scale(1.4); }
			  }
			  .kpi.champions .dot, .kpi.champions .dot::after { background: var(--champions); }
			  .kpi.big-spenders .dot, .kpi.big-spenders .dot::after { background: var(--big-spenders); }
			  .kpi.novos .dot, .kpi.novos .dot::after { background: var(--novos); }
			  .kpi.em-risco .dot, .kpi.em-risco .dot::after { background: var(--em-risco); }
			  .kpi.clientes .dot, .kpi.clientes .dot::after { background: var(--text-2); }
			  .kpi .label { font-size: 11px; color: var(--text-2); font-weight: 500; letter-spacing: 0.3px; }
			  /* KPI value/MoM/bar &#8212; card autocontido (uma camada s&#243;, sem overlay SVG) */
			  .kpi { display: flex; flex-direction: column; justify-content: space-between; padding: 9px 14px; }
			  .kpi .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
			  .kpi .value { font-size: 24px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-1); font-variant-numeric: tabular-nums; line-height: 1; }
			  .kpi .pill { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 9px; white-space: nowrap; line-height: 1.4; flex-shrink: 0; }
			  .kpi .pill.up   { background: #15351f; color: #34D399; }
			  .kpi .pill.down { background: #3a1416; color: #E5484D; }
			  .kpi .pill.warn { background: #3a3115; color: #F2C94C; }
				  .kpi .pill.flat { background: #26272E; color: #A1A1AA; }
			  .kpi .bar { position: relative; height: 5px; border-radius: 3px; background: rgba(255,255,255,0.12); }
			  .kpi .bar-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; }
			  .kpi .bar-tick { position: absolute; left: 50%; top: -3px; width: 2px; height: 11px; border-radius: 1px; background: rgba(255,255,255,0.8); }
				  .kpi .spark { margin-top: 4px; line-height: 0; }
			
			  /* &#9472;&#9472;&#9472; Page 1 layout &#9472;&#9472;&#9472; */
			  .content { display: grid; grid-template-columns: 74% 26%; gap: 8px; min-height: 0; }
			  .visuals { display: grid; grid-template-rows: 1.5fr 1fr; gap: 8px; min-height: 0; }
			  .visual-bottom { display: grid; grid-template-columns: 5fr 6fr; gap: 8px; min-height: 0; }
			
			  /* &#9472;&#9472;&#9472; Panel &#8212; header s&#243;, corpo vazio (visual PBI por cima) &#9472;&#9472;&#9472; */
			  .panel {
			    background: var(--bg-card);
			
			    border: 1px solid var(--border);
			    border-radius: 12px;
			    padding: 5px 12px 10px 12px;
			    display: flex; flex-direction: column;
			    min-height: 0; position: relative; overflow: hidden; gap: 8px;
			  }
			  .panel-header { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
			  .panel-title { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; color: var(--text-1); }
			  .panel-sub { font-size: 11px; color: var(--text-3); margin-top: 2px; line-height: 1.3; }
			  .panel-badge {
			    font-size: 9px; padding: 4px 9px; border-radius: 6px; font-weight: 600;
			    letter-spacing: 0.7px; text-transform: uppercase;
			    border: 1px solid var(--border-strong); flex-shrink: 0; align-self: flex-start;
			  }
			  .badge-green { background: var(--champions-soft); color: var(--champions); border-color: rgba(94,106,210,0.2); }
			  .badge-purple { background: var(--big-spenders-soft); color: var(--big-spenders); border-color: rgba(191,111,248,0.2); }
			  .badge-gold { background: var(--novos-soft); color: var(--novos); border-color: rgba(242,201,76,0.2); }
			  .badge-red { background: var(--em-risco-soft); color: var(--em-risco); border-color: rgba(229,72,77,0.2); }
			
			  /* &#9472;&#9472;&#9472; AI panel &#8212; header s&#243; &#9472;&#9472;&#9472; */
			  .ai-panel {
			    background: var(--bg-card);
			
			    border: 1px solid var(--border);
			    border-radius: 16px;
			    display: flex; flex-direction: column;
			    min-height: 0; overflow: hidden;
			  }
			  .ai-header {
			    padding: 14px 16px; border-bottom: 1px solid var(--border);
			    display: flex; align-items: center; gap: 12px;
			  }
			  .ai-avatar {
			    width: 36px; height: 36px; border-radius: 10px;
			    background: linear-gradient(135deg, #1F2030, #14151D);
			    border: 1px solid var(--border-strong);
			    display: flex; align-items: center; justify-content: center;
			    font-size: 16px; color: var(--champions);
			    position: relative; flex-shrink: 0;
			  }
			  .ai-avatar::before {
			    content: ''; position: absolute; inset: -8px; border-radius: 18px;
			    background: radial-gradient(circle, var(--champions) 0%, transparent 70%);
			    opacity: 0.15; animation: avatarGlow 4s ease-in-out infinite; z-index: -1;
			  }
			  @keyframes avatarGlow {
			    0%, 100% { opacity: 0.10; transform: scale(1); }
			    50% { opacity: 0.25; transform: scale(1.15); }
			  }
			  .ai-info { flex: 1; min-width: 0; }
			  .ai-name { font-size: 13px; font-weight: 600; letter-spacing: -0.2px; color: var(--text-1); }
			  .ai-status { font-size: 11px; color: var(--text-3); display: flex; align-items: center; gap: 6px; margin-top: 2px; }
			  .ai-status::before {
			    content: ''; width: 7px; height: 7px;
			    background: var(--champions); border-radius: 50%;
			    animation: pulse 2.2s infinite;
			  }
			  @keyframes pulse {
			    0%, 100% { opacity: 1; }
			    50% { opacity: 0.35; }
			  }
			  /* AI panel - card de produto (sem iframe) */
			  .ai-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 11px; flex: 1; min-height: 0; }
			  .ai-lead { font-size: 12px; line-height: 1.5; color: var(--text-2); }
			  .ai-lead b { color: var(--text-1); font-weight: 600; }
			  .ai-eg-label { font-size: 9px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--text-3); font-weight: 600; }
			  .ai-eg { display: flex; flex-direction: column; gap: 7px; }
			  .ai-eg .eg { font-size: 11.5px; color: var(--text-2); background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; }
			  .ai-cta {
			    margin-top: auto; text-align: center; font-size: 13px; font-weight: 600; color: #fff;
			    background: linear-gradient(135deg, var(--big-spenders), var(--champions));
			    border-radius: 10px; padding: 12px; letter-spacing: -0.1px;
			    box-shadow: 0 4px 14px rgba(94,106,210,0.35);
			  }
			  .ai-foot { font-size: 10px; color: var(--text-3); text-align: center; }
			
			  /* &#9472;&#9472;&#9472; Footer &#9472;&#9472;&#9472; */
			  .footer {
			    display: flex; justify-content: space-between; align-items: center;
			    padding: 0 12px;
			    font-size: 12px; color: var(--text-muted); font-weight: 500;
			  }
			
			  @media (prefers-reduced-motion: reduce) {
			    *, *::before, *::after { animation: none !important; transition: none !important; }
			  }
			</style>
			</head>
			<body>
			
			<div class=""bg-mesh"">
			</div>
			
			<div class=""dashboard"">
			
			  <!-- TOPBAR -->
			  <header class=""topbar"">
			    <div class=""brand"">
			      <div class=""logo""></div>
			      <div>
			        <h1>RFM Olist Intelligence</h1>
			        <div class=""sub"">BASE OLIST &#183; SET/16 &#8211; AGO/18</div>
			      </div>
			    </div>
			    <div class=""tabs"">
			      <button class=""tab active"">Vis&#227;o Executiva</button>
			      <button class=""tab"">An&#225;lise Detalhada</button>
			    </div>
			    <div class=""topbar-meta"">
			      <div class=""meta-pill""><div class=""label"">Snapshot</div><div class=""value"">04 Set 2018</div></div>
			      <div class=""meta-pill""><div class=""label"">Modelo</div><div class=""value"">K-Means &#183; 4 segmentos</div></div>
			    </div>
			  </header>
			
			  <!-- P&#193;GINA 1 -->
			  <div class=""page"">
			
			    <!-- KPI cards (valor + MoM + barra injetados via DAX &#8212; uma camada s&#243;) -->
			    <section class=""kpis"">" & kpiCli & kpiRec & kpiTic & kpiRis & "</section>
			
			    <main class=""content"">
			      <div class=""visuals"">
			
			        <!-- Painel: Treemap (corpo vazio &#8212; visual PBI por cima) -->
			        <div class=""panel"">
			          <div class=""panel-header"">
			            <div>
			              <h2 class=""panel-title"">Distribui&#231;&#227;o de receita por cluster</h2>
			
			            </div>
			            			          </div>
			        </div>
			
			        <div class=""visual-bottom"">
			          <!-- Painel: Lorenz -->
			          <div class=""panel"">
			            <div class=""panel-header"">
			              <div>
			                <h2 class=""panel-title"">Concentra&#231;&#227;o de receita</h2>
			              </div>
			              			            </div>
			          </div>
			          <!-- Painel: CLV vs AOV -->
			          <div class=""panel"">
			            <div class=""panel-header"">
			              <div>
			                <h2 class=""panel-title"">CLV projetado vs Ticket atual</h2>
			                			              </div>
			              			            </div>
			          </div>
			        </div>
			
			      </div>
			
			      <!-- AI panel - card de produto (botao nativo Abrir Analista por cima do .ai-cta) -->
			      <aside class=""ai-panel"">
			        <div class=""ai-header"">
			          <div class=""ai-avatar"">&#10022;</div>
			          <div class=""ai-info"">
			            <div class=""ai-name"">Analista RFM</div>
			            <div class=""ai-status"">Claude Haiku 4.5 &#183; IA embarcada</div>
			          </div>
			        </div>
			        <div class=""ai-body"">
			          <div class=""ai-lead"">Converse com a base de <b>" & FORMAT(ROUND(CALCULATE([Total Clientes], ALL(fato_rfm_clientes))/1000, 0), "#,0", "pt-BR") & " mil clientes</b> em linguagem natural &#8212; clusters, risco de churn e a&#231;&#245;es de CRM, com n&#250;meros reais.</div>
			          <div class=""ai-eg-label"">Experimente perguntar</div>
			          <div class=""ai-eg"">
			            <div class=""eg"">&rsaquo; Quantos clientes em risco em SP?</div>
			            <div class=""eg"">&rsaquo; Plano de win-back para Big Spenders</div>
			            <div class=""eg"">&rsaquo; Como proteger os Campe&#245;es?</div>
			          </div>
			          <div class=""ai-cta"">&#10022; Abrir Analista (IA) &rarr;</div>
			          			        </div>
			      </aside>
			
			    </main>
			  </div>
			
			  <!-- footer removido -->
			
			</div>
			
			</body>
			</html>
			"
		lineageTag: dc66a805-f3a6-4001-a74c-7af07d7ebcf9

	/// HTML chrome Pagina 2
	measure '_BG Pagina 2' =
						"<!DOCTYPE html>
						<html lang=""pt-BR"">
						<head>
						<meta charset=""UTF-8"">
						<title>Background P2 &#8212; An&#225;lise Detalhada (chrome)</title>
						<style>
						  :root {
						    --bg-base: #08090A;
						    --bg-elev-1: #0E0F11;
						    --bg-elev-2: #131418;
						    --bg-card: rgba(20, 22, 30, 0.85);
						    --bg-card-solid: #14151D;
						    --border: rgba(255, 255, 255, 0.06);
						    --border-hover: rgba(255, 255, 255, 0.14);
						    --border-strong: rgba(255, 255, 255, 0.10);
						    --text-1: #F4F4F5;
						    --text-2: #A1A1AA;
						    --text-3: #8B8B92;
						    --text-muted: #6B6B73;
						    --champions: #5E6AD2;
						    --big-spenders: #BF6FF8;
						    --novos: #F2C94C;
						    --em-risco: #E5484D;
						    --champions-soft: rgba(94, 106, 210, 0.12);
						    --big-spenders-soft: rgba(191, 111, 248, 0.12);
						    --novos-soft: rgba(242, 201, 76, 0.12);
						    --em-risco-soft: rgba(229, 72, 77, 0.12);
						  }
			
						  * { box-sizing: border-box; margin: 0; padding: 0; }
						  /* Anti user-agent: for&#231;a headings a herdar cor/peso/tamanho do contexto */
						  h1, h2, h3, h4, h5, h6 { color: inherit; font: inherit; }
						  html, body { width: 100%; height: 100%; overflow: hidden; }
			
						  body {
						    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
						    background: radial-gradient(900px 600px at 12% 8%, rgba(191,111,248,0.10), transparent 65%), radial-gradient(800px 550px at 88% 92%, rgba(94,106,210,0.09), transparent 65%), radial-gradient(700px 500px at 55% 45%, rgba(191,111,248,0.05), transparent 60%), var(--bg-base);
						    color: var(--text-1);
						    -webkit-font-smoothing: antialiased;
						    position: relative;
						  }
			
						  /* &#9472;&#9472;&#9472; Background aurora animada &#9472;&#9472;&#9472; */
						  .bg-mesh { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
						  /* Aurora leve: camada unica, so transform+opacity (compositor GPU, sem repaint) */
						  .bg-mesh::before { content: ''; position: absolute; inset: -20%; background: radial-gradient(700px 500px at 20% 15%, rgba(191,111,248,0.14), transparent 60%), radial-gradient(600px 450px at 80% 85%, rgba(94,106,210,0.12), transparent 60%); animation: aurora 26s ease-in-out infinite alternate; will-change: transform, opacity; }
						  @keyframes aurora { 0% { transform: translate3d(-2%, -1%, 0); opacity: 0.55; } 100% { transform: translate3d(2%, 2%, 0); opacity: 1; } }
						  .bg-mesh::after {
						    content: ''; position: absolute; inset: 0;
						    background: radial-gradient(ellipse at center, transparent 30%, rgba(8, 9, 10, 0.55) 100%);
						  }
			
						  /* &#9472;&#9472;&#9472; Layout &#8212; aspect-ratio deriva a altura da largura (robusto em qualquer 16:9) &#9472;&#9472;&#9472; */
						  .dashboard {
						    position: relative; z-index: 1;
						    width: 100%; aspect-ratio: 16 / 9;
						    display: grid;
						    grid-template-rows: 56px 1fr 22px;
						    padding: 10px 14px; gap: 8px;
						  }
			
						  /* &#9472;&#9472;&#9472; Topbar &#9472;&#9472;&#9472; */
						  .topbar {
						    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
						    gap: 20px; padding: 0 16px;
						    background: var(--bg-card);
			
						    border: 1px solid var(--border); border-radius: 12px;
						  }
						  .brand { display: flex; align-items: center; gap: 12px; }
						  .logo {
						    width: 34px; height: 34px; border-radius: 9px;
						    background: linear-gradient(135deg, var(--big-spenders), #9D54E5);
						    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
						  }
						  .logo::after {
						    content: ''; width: 11px; height: 11px;
						    background: var(--bg-base); border-radius: 2px; transform: rotate(45deg);
						  }
						  .brand h1 { font-size: 15px; font-weight: 600; letter-spacing: -0.2px; color: var(--text-1); line-height: 1; }
						  .brand .sub { font-size: 10px; color: var(--text-2); letter-spacing: 1.6px; font-weight: 600; margin-top: 2px; text-transform: uppercase; opacity: 0.85; line-height: 1; }
			
						  .tabs {
						    display: flex; gap: 3px; justify-self: center;
						    background: rgba(255, 255, 255, 0.03);
						    border: 1px solid var(--border);
						    padding: 4px; border-radius: 12px;
						  }
						  .tab {
						    padding: 7px 18px; border-radius: 7px;
						    font: 500 13px inherit; color: var(--text-2);
						    background: transparent; border: none;
						  }
						  .tab.active {
						    background: var(--bg-card-solid); color: var(--text-1);
						    border: 1px solid var(--border-strong);
						  }
			
						  .topbar-meta { display: flex; gap: 14px; }
						  .meta-pill { padding: 2px 12px; border-left: 1px solid var(--border); }
						  .meta-pill .label { font-size: 9px; color: var(--text-3); letter-spacing: 1.2px; font-weight: 600; text-transform: uppercase; }
						  .meta-pill .value { font-size: 12px; font-weight: 600; margin-top: 2px; font-variant-numeric: tabular-nums; letter-spacing: -0.1px; color: var(--text-1); }
			
						  /* &#9472;&#9472;&#9472; Page &#9472;&#9472;&#9472; */
						  .page { display: grid; grid-template-rows: auto 1fr; gap: 8px; min-height: 0; height: 100%; }
			
						  /* &#9472;&#9472;&#9472; KPIs &#8212; frames vazios &#9472;&#9472;&#9472; */
						  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
						  .kpi {
						    background: var(--bg-card);
			
						    border: 1px solid var(--border);
						    border-radius: 12px;
						    padding: 10px 14px;
						    position: relative; min-height: 70px; overflow: hidden;
						  }
						  .kpi::before {
						    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
						    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
						  }
						  .kpi .label-row { display: flex; align-items: center; gap: 8px; }
						  .kpi .dot { width: 8px; height: 8px; border-radius: 50%; position: relative; }
						  .kpi .dot::after {
						    content: ''; position: absolute; inset: -3px;
						    border-radius: 50%; background: inherit;
						    opacity: 0.3; filter: blur(4px);
						    animation: dotPulse 3s ease-in-out infinite;
						  }
						  @keyframes dotPulse {
						    0%, 100% { opacity: 0.3; transform: scale(1); }
						    50% { opacity: 0.6; transform: scale(1.4); }
						  }
						  .kpi.champions .dot, .kpi.champions .dot::after { background: var(--champions); }
						  .kpi.big-spenders .dot, .kpi.big-spenders .dot::after { background: var(--big-spenders); }
						  .kpi.novos .dot, .kpi.novos .dot::after { background: var(--novos); }
						  .kpi.em-risco .dot, .kpi.em-risco .dot::after { background: var(--em-risco); }
						  .kpi .label { font-size: 11px; color: var(--text-2); font-weight: 500; letter-spacing: 0.3px; }
			
						  .diagnostic-bar { display: flex; align-items: center; gap: 14px; background: var(--bg-card);  border: 1px solid var(--border); border-left: 3px solid var(--em-risco); border-radius: 12px; padding: 9px 18px; height: 70px; overflow: hidden; } .diag-icon { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--em-risco-soft); color: var(--em-risco); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 16px; } .diag-text { display: flex; flex-direction: column; gap: 3px; } .diag-title { font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--em-risco); } .diag-body { font-size: 11.5px; line-height: 1.3; color: var(--text-2); } .diag-body b { color: var(--text-1); font-weight: 700; } /* &#9472;&#9472;&#9472; Page 2 layout &#8212; 3 colunas &#215; 2 linhas &#9472;&#9472;&#9472; */
						  .content { display: grid; grid-template-rows: 1fr 1fr; gap: 8px; min-height: 0; }
						  .visual-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; min-height: 0; }
			
						  /* &#9472;&#9472;&#9472; Panel &#8212; header s&#243;, corpo vazio &#9472;&#9472;&#9472; */
						  .panel {
						    background: var(--bg-card);
			
						    border: 1px solid var(--border);
						    border-radius: 12px;
						    padding: 10px 12px;
						    display: flex; flex-direction: column;
						    min-height: 0; position: relative; overflow: hidden; gap: 8px;
						  }
						  .panel-header { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
						  .panel-title { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; color: var(--text-1); }
						  .panel-sub { font-size: 11px; color: var(--text-3); margin-top: 2px; line-height: 1.3; }
						  .panel-badge {
						    font-size: 9px; padding: 4px 9px; border-radius: 6px; font-weight: 600;
						    letter-spacing: 0.7px; text-transform: uppercase;
						    border: 1px solid var(--border-strong); flex-shrink: 0; align-self: flex-start;
						  }
						  .badge-green { background: var(--champions-soft); color: var(--champions); border-color: rgba(94,106,210,0.2); }
						  .badge-purple { background: var(--big-spenders-soft); color: var(--big-spenders); border-color: rgba(191,111,248,0.2); }
						  .badge-gold { background: var(--novos-soft); color: var(--novos); border-color: rgba(242,201,76,0.2); }
						  .badge-red { background: var(--em-risco-soft); color: var(--em-risco); border-color: rgba(229,72,77,0.2); }
			
						  /* &#9472;&#9472;&#9472; Footer &#9472;&#9472;&#9472; */
						  .footer {
						    display: flex; justify-content: space-between; align-items: center;
						    padding: 0 12px;
						    font-size: 12px; color: var(--text-muted); font-weight: 500;
						  }
			
						  @media (prefers-reduced-motion: reduce) {
						    *, *::before, *::after { animation: none !important; transition: none !important; }
						  }
						</style>
						</head>
						<body>
			
						<div class=""bg-mesh"">
						</div>
			
						<div class=""dashboard"">
			
						  <!-- TOPBAR -->
						  <header class=""topbar"">
						    <div class=""brand"">
						      <div class=""logo""></div>
						      <div>
						        <h1>RFM Olist Intelligence</h1>
						        <div class=""sub"">BASE OLIST &#183; SET/16 &#8211; AGO/18</div>
						      </div>
						    </div>
						    <div class=""tabs"">
						      <button class=""tab"">Vis&#227;o Executiva</button>
						      <button class=""tab active"">An&#225;lise Detalhada</button>
						    </div>
						    <div class=""topbar-meta"">
						      <div class=""meta-pill""><div class=""label"">Snapshot</div><div class=""value"">04 Set 2018</div></div>
						      <div class=""meta-pill""><div class=""label"">Modelo</div><div class=""value"">K-Means &#183; 4 segmentos</div></div>
						    </div>
						  </header>
			
						  <!-- P&#193;GINA 2 -->
						  <div class=""page"">
			
						    <section class=""diagnostic-bar""><div class=""diag-icon"">&#33;</div><div class=""diag-text""><span class=""diag-title"">Diagn&#243;stico gerencial</span><span class=""diag-body"">A base concentra receita e tem <b>baixa recorr&#234;ncia</b>: cerca de <b>" & FORMAT(CALCULATE([% Compra Unica], ALL(fato_rfm_clientes)), "0%", "pt-BR") & " dos clientes compram uma &#250;nica vez</b> e a reten&#231;&#227;o cai para <b>" & FORMAT(CALCULATE(DIVIDE(SUM(fato_cohort[Clientes_Retidos]), SUM(fato_cohort[Tamanho_Safra])), fato_cohort[MesIndice]=1, ALL(fato_cohort)), "0.0%", "pt-BR") & "</b> ap&#243;s a 1&#170; compra. H&#225; <b>" & "R$ " & FORMAT(DIVIDE(CALCULATE([Receita em Risco], ALL(fato_rfm_clientes)), 1000000), "0.0", "pt-BR") & " mi</b> de receita ligada a clientes hibernando (<b>" & FORMAT(CALCULATE([% Em Risco], ALL(fato_rfm_clientes)), "0.0%", "pt-BR") & " da base</b>). Maior alavanca: ativar a 2&#170; compra em <b>Novos / Ocasionais</b> e recuperar <b>Em Risco / Hibernando</b>.</span></div></section><!--
						    <section class=""kpis"">
						      <div class=""kpi champions"">
						        <div class=""label-row""><span class=""dot""></span><span class=""label"">Review m&#233;dio</span></div>
						      </div>
						      <div class=""kpi big-spenders"">
						        <div class=""label-row""><span class=""dot""></span><span class=""label"">CLV m&#233;dio</span></div>
						      </div>
						      <div class=""kpi novos"">
						        <div class=""label-row""><span class=""dot""></span><span class=""label"">Compra &#250;nica</span></div>
						      </div>
						      <div class=""kpi em-risco"">
						        <div class=""label-row""><span class=""dot""></span><span class=""label"">Recency m&#233;dia</span></div>
						      </div>
						    </section>
			
						    <main class=""content"">
			
						      <div class=""visual-row"">
						        --><main class=""content""><div class=""visual-row""><!-- Painel: Evolu&#231;&#227;o mensal -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Evolu&#231;&#227;o mensal</h2>
			            </div>
			            						          </div>
						        </div>
						        <!-- Painel: Evolu&#231;&#227;o mensal -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Reten&#231;&#227;o por safra</h2>
			            </div>
			            						          </div>
						        </div>
						        <!-- Painel: Cohort de reten&#231;&#227;o -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Risco de review por UF</h2>
			            </div>
			            						          </div>
						        </div>
						      </div>
			
						      <div class=""visual-row"">
						        <!-- Painel: Top 50 Campe&#245;es -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Funil de recorr&#234;ncia</h2>
			            </div>
			            						          </div>
						        </div>
						        <!-- Painel: Funil de convers&#227;o -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Receita em risco por segmento</h2>
			            </div>
			            						          </div>
						        </div>
						        <!-- Painel: Review &#215; Risco de churn -->
						        <div class=""panel"">
						          <div class=""panel-header"">
						            <div>
						              <h2 class=""panel-title"">Plano de a&#231;&#227;o</h2>
			            </div>
			            						          </div>
						        </div>
						      </div>
			
						    </main>
						  </div>
			
						  <!-- footer removido -->
			
						</div>
			
						</body>
						</html>
						"
		lineageTag: 6fe8b3b0-47e9-4ba0-897c-1480182bbc81

	measure '_Plano Acao' =
			VAR recRisco = CALCULATE([Receita Total], ALL(fato_rfm_clientes), fato_rfm_clientes[Cluster_Name]="Em Risco / Hibernando", fato_rfm_clientes[Recency]>365)
			VAR recBig = CALCULATE([Receita Total], ALL(fato_rfm_clientes), fato_rfm_clientes[Cluster_Name]="Big Spenders (Não-Recorrentes)")
			VAR recNovos = CALCULATE([Receita Total], ALL(fato_rfm_clientes), fato_rfm_clientes[Cluster_Name]="Novos / Ocasionais")
			VAR recCamp = CALCULATE([Receita Total], ALL(fato_rfm_clientes), fato_rfm_clientes[Cluster_Name]="Campeões")
			VAR f1 = "R$ " & FORMAT(DIVIDE(recRisco,1000000),"0.0","pt-BR") & " mi em risco"
			VAR f2 = "R$ " & FORMAT(DIVIDE(recBig,1000000),"0.0","pt-BR") & " mi sem recompra"
			VAR f3 = "R$ " & FORMAT(DIVIDE(recNovos,1000000),"0.0","pt-BR") & " mi &#183; " & FORMAT(CALCULATE([% Compra Unica], ALL(fato_rfm_clientes)), "0%", "pt-BR") & " compra &#250;nica"
			VAR f4 = "R$ " & FORMAT(DIVIDE(recCamp,1000000),"0.0","pt-BR") & " mi recompra real"
			VAR css = "*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;background:transparent !important;overflow:hidden;font-family:Segoe UI,sans-serif}.w{display:flex;flex-direction:column;gap:6px;height:100%;justify-content:center}.r{display:flex;align-items:center;gap:9px;background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:7px 9px}.bar{width:4px;align-self:stretch;border-radius:2px;flex-shrink:0}.pri{font-size:9px;font-weight:800;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#0A0A0F}.tx{flex:1;min-width:0}.seg{font-size:11.5px;font-weight:700;color:#F4F4F5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ac{font-size:10px;color:#A1A1AA;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.val{font-size:10px;font-weight:700;text-align:right;flex-shrink:0;white-space:nowrap}"
			VAR rowRisco = "<div class='r'><div class='bar' style='background:#E5484D'></div><div class='pri' style='background:#E5484D'>1</div><div class='tx'><div class='seg'>Em Risco / Hibernando</div><div class='ac'>Win-back urgente: reativa&#231;&#227;o + desconto</div></div><div class='val' style='color:#E5484D'>" & f1 & "</div></div>"
			VAR rowBig = "<div class='r'><div class='bar' style='background:#BF6FF8'></div><div class='pri' style='background:#BF6FF8'>2</div><div class='tx'><div class='seg'>Big Spenders</div><div class='ac'>Converter p/ recorr&#234;ncia: upsell p&#243;s-venda</div></div><div class='val' style='color:#BF6FF8'>" & f2 & "</div></div>"
			VAR rowNovos = "<div class='r'><div class='bar' style='background:#F2C94C'></div><div class='pri' style='background:#F2C94C'>3</div><div class='tx'><div class='seg'>Novos / Ocasionais</div><div class='ac'>Ativar 2&#170; compra: cupom volte logo</div></div><div class='val' style='color:#F2C94C'>" & f3 & "</div></div>"
			VAR rowCamp = "<div class='r'><div class='bar' style='background:#5E6AD2'></div><div class='pri' style='background:#5E6AD2'>4</div><div class='tx'><div class='seg'>Campe&#245;es</div><div class='ac'>Proteger e fidelizar: programa VIP</div></div><div class='val' style='color:#5E6AD2'>" & f4 & "</div></div>"
			RETURN
			"<!DOCTYPE html><html><head><meta charset='UTF-8'><style>" & css & "</style></head><body><div class='w'>" & rowRisco & rowBig & rowNovos & rowCamp & "</div></body></html>"
		displayFolder: Cards SVG
		lineageTag: 6fe8b3b0-0002-4ba0-897c-1480182bbc81

	/// Sparkline 12 meses - Clientes
	measure '_Spark Clientes' =
			VAR _N = 12
			VAR _Color = "#A1A1AA"
			VAR _W = 120
			VAR _H = 24
			VAR _Pad = 3
			VAR _MaxDate = MAX(fato_pedidos[order_purchase_timestamp])
			VAR _RefDate = IF(_MaxDate < EOMONTH(_MaxDate,0), EOMONTH(_MaxDate,-1), EOMONTH(_MaxDate,0))
			VAR _Series = ADDCOLUMNS(GENERATESERIES(0, _N-1, 1), "@val", VAR _off = [Value] VAR _d = EDATE(_RefDate, _off-(_N-1)) VAR _yy = YEAR(_d) VAR _mm = MONTH(_d) RETURN CALCULATE(DISTINCTCOUNT(fato_pedidos[customer_unique_id]), FILTER(ALL(dim_calendario), dim_calendario[Ano]=_yy && dim_calendario[Mes]=_mm)))
			VAR _Min = MINX(_Series,[@val])
			VAR _Max = MAXX(_Series,[@val])
			VAR _Rng = _Max-_Min
			VAR _InnerH = _H-2*_Pad
			VAR _Pts = CONCATENATEX(_Series, FORMAT(DIVIDE([Value],_N-1)*_W,"0") & "," & FORMAT(_H-_Pad-DIVIDE([@val]-_Min,_Rng,0.5)*_InnerH,"0"), " ", [Value], ASC)
			VAR _LastY = _H-_Pad-DIVIDE(MAXX(FILTER(_Series,[Value]=_N-1),[@val])-_Min,_Rng,0.5)*_InnerH
			VAR _Area = "<polygon points=""0," & _H & " " & _Pts & " " & _W & "," & _H & """ fill=""" & _Color & """ fill-opacity=""0.12""/>"
			VAR _Line = "<polyline points=""" & _Pts & """ fill=""none"" stroke=""" & _Color & """ stroke-width=""1.5"" stroke-linejoin=""round"" stroke-linecap=""round""/>"
			VAR _Dot = "<circle cx=""" & _W & """ cy=""" & FORMAT(_LastY,"0") & """ r=""2.2"" fill=""" & _Color & """/>"
			RETURN "<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 " & _W & " " & _H & """ preserveAspectRatio=""none"" style=""width:100%;height:" & _H & "px;display:block"">" & _Area & _Line & _Dot & "</svg>"
		displayFolder: Sparklines
		lineageTag: 7a1c0001-aaaa-4bbb-8ccc-000000000001

	/// Sparkline 12 meses - Receita
	measure '_Spark Receita' =
			VAR _N = 12
			VAR _Color = "#5E6AD2"
			VAR _W = 120
			VAR _H = 24
			VAR _Pad = 3
			VAR _MaxDate = MAX(fato_pedidos[order_purchase_timestamp])
			VAR _RefDate = IF(_MaxDate < EOMONTH(_MaxDate,0), EOMONTH(_MaxDate,-1), EOMONTH(_MaxDate,0))
			VAR _Series = ADDCOLUMNS(GENERATESERIES(0, _N-1, 1), "@val", VAR _off = [Value] VAR _d = EDATE(_RefDate, _off-(_N-1)) VAR _yy = YEAR(_d) VAR _mm = MONTH(_d) RETURN CALCULATE(SUM(fato_pedidos[monetary_value]), FILTER(ALL(dim_calendario), dim_calendario[Ano]=_yy && dim_calendario[Mes]=_mm)))
			VAR _Min = MINX(_Series,[@val])
			VAR _Max = MAXX(_Series,[@val])
			VAR _Rng = _Max-_Min
			VAR _InnerH = _H-2*_Pad
			VAR _Pts = CONCATENATEX(_Series, FORMAT(DIVIDE([Value],_N-1)*_W,"0") & "," & FORMAT(_H-_Pad-DIVIDE([@val]-_Min,_Rng,0.5)*_InnerH,"0"), " ", [Value], ASC)
			VAR _LastY = _H-_Pad-DIVIDE(MAXX(FILTER(_Series,[Value]=_N-1),[@val])-_Min,_Rng,0.5)*_InnerH
			VAR _Area = "<polygon points=""0," & _H & " " & _Pts & " " & _W & "," & _H & """ fill=""" & _Color & """ fill-opacity=""0.12""/>"
			VAR _Line = "<polyline points=""" & _Pts & """ fill=""none"" stroke=""" & _Color & """ stroke-width=""1.5"" stroke-linejoin=""round"" stroke-linecap=""round""/>"
			VAR _Dot = "<circle cx=""" & _W & """ cy=""" & FORMAT(_LastY,"0") & """ r=""2.2"" fill=""" & _Color & """/>"
			RETURN "<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 " & _W & " " & _H & """ preserveAspectRatio=""none"" style=""width:100%;height:" & _H & "px;display:block"">" & _Area & _Line & _Dot & "</svg>"
		displayFolder: Sparklines
		lineageTag: 7a1c0001-aaaa-4bbb-8ccc-000000000002

	/// Sparkline 12 meses - Ticket
	measure '_Spark Ticket' =
			VAR _N = 12
			VAR _Color = "#F2C94C"
			VAR _W = 120
			VAR _H = 24
			VAR _Pad = 3
			VAR _MaxDate = MAX(fato_pedidos[order_purchase_timestamp])
			VAR _RefDate = IF(_MaxDate < EOMONTH(_MaxDate,0), EOMONTH(_MaxDate,-1), EOMONTH(_MaxDate,0))
			VAR _Series = ADDCOLUMNS(GENERATESERIES(0, _N-1, 1), "@val", VAR _off = [Value] VAR _d = EDATE(_RefDate, _off-(_N-1)) VAR _yy = YEAR(_d) VAR _mm = MONTH(_d) RETURN CALCULATE(DIVIDE(SUM(fato_pedidos[monetary_value]), COUNTROWS(fato_pedidos)), FILTER(ALL(dim_calendario), dim_calendario[Ano]=_yy && dim_calendario[Mes]=_mm)))
			VAR _Min = MINX(_Series,[@val])
			VAR _Max = MAXX(_Series,[@val])
			VAR _Rng = _Max-_Min
			VAR _InnerH = _H-2*_Pad
			VAR _Pts = CONCATENATEX(_Series, FORMAT(DIVIDE([Value],_N-1)*_W,"0") & "," & FORMAT(_H-_Pad-DIVIDE([@val]-_Min,_Rng,0.5)*_InnerH,"0"), " ", [Value], ASC)
			VAR _LastY = _H-_Pad-DIVIDE(MAXX(FILTER(_Series,[Value]=_N-1),[@val])-_Min,_Rng,0.5)*_InnerH
			VAR _Area = "<polygon points=""0," & _H & " " & _Pts & " " & _W & "," & _H & """ fill=""" & _Color & """ fill-opacity=""0.12""/>"
			VAR _Line = "<polyline points=""" & _Pts & """ fill=""none"" stroke=""" & _Color & """ stroke-width=""1.5"" stroke-linejoin=""round"" stroke-linecap=""round""/>"
			VAR _Dot = "<circle cx=""" & _W & """ cy=""" & FORMAT(_LastY,"0") & """ r=""2.2"" fill=""" & _Color & """/>"
			RETURN "<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 " & _W & " " & _H & """ preserveAspectRatio=""none"" style=""width:100%;height:" & _H & "px;display:block"">" & _Area & _Line & _Dot & "</svg>"
		displayFolder: Sparklines
		lineageTag: 7a1c0001-aaaa-4bbb-8ccc-000000000003

	/// Sparkline 12 meses - Pedidos
	measure '_Spark Pedidos' =
			VAR _N = 12
			VAR _Color = "#BF6FF8"
