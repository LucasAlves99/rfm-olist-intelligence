table _Saude
	lineageTag: f78fa397-6869-4084-aa17-e341dc445cd2

	measure 'Clientes em Risco' = CALCULATE([Total Clientes], fato_rfm_clientes[Recency] > 365)
		formatString: #,0
		lineageTag: 06ea85b7-cf26-4d7d-bcfa-4858703e21ba

	measure '% Em Risco' = DIVIDE([Clientes em Risco], [Total Clientes])
		formatString: 0.0%
		lineageTag: 65cc016c-1ae4-4bcc-9ca4-f8e81d18d9f0

	measure '% Compra Unica' = DIVIDE(CALCULATE([Total Clientes], fato_rfm_clientes[Frequency] = 1), [Total Clientes])
		formatString: 0.0%
		lineageTag: 02c8d907-e94f-4fe7-8f41-dae63897195d

	measure '% Campeoes' = DIVIDE(CALCULATE([Total Clientes], fato_rfm_clientes[Cluster_Name]="Campeões"), [Total Clientes])
		formatString: 0.0%
		lineageTag: 0dbe01c8-5fdf-42d1-8b62-8cdb4e1295c7

	measure '% Big Spenders' = DIVIDE(CALCULATE([Total Clientes], fato_rfm_clientes[Cluster_Name]="Big Spenders (Não-Recorrentes)"), [Total Clientes])
		formatString: 0.0%
		lineageTag: 54071b7d-a1d0-41b0-a1d4-fbee8476bcb5

	measure '% Novos' = DIVIDE(CALCULATE([Total Clientes], fato_rfm_clientes[Cluster_Name]="Novos / Ocasionais"), [Total Clientes])
		formatString: 0.0%
		lineageTag: 462e1bca-0da5-477e-bc4d-cdd3bfd8fb64

	measure 'Clientes 1 Compra' = CALCULATE([Total Clientes], fato_rfm_clientes[Frequency]=1)
		formatString: #,0
		displayFolder: Funil
		lineageTag: 442367b4-4160-4956-8c23-9bd7648c48da

	measure 'Clientes 2 Compras' = CALCULATE([Total Clientes], fato_rfm_clientes[Frequency]=2)
		formatString: #,0
		displayFolder: Funil
		lineageTag: bf868286-2c42-488b-b423-d6846ced05f9

	measure 'Clientes 3-4 Compras' = CALCULATE([Total Clientes], fato_rfm_clientes[Frequency]>=3, fato_rfm_clientes[Frequency]<=4)
		formatString: #,0
		displayFolder: Funil
		lineageTag: 63ceba9f-fd7b-4acf-835e-780c9314a6a8

	measure 'Clientes 5+ Compras' = CALCULATE([Total Clientes], fato_rfm_clientes[Frequency]>=5)
		formatString: #,0
		displayFolder: Funil
		lineageTag: 4d0d75c8-dbb3-4370-9c1e-474bc88ca43a

	measure 'Receita em Risco' = CALCULATE([Receita Total], fato_rfm_clientes[Recency] > 365)
		formatString: "R$ "#,0
		displayFolder: Risco
		lineageTag: 1f2a3b4c-5d6e-4f70-8a91-b2c3d4e5f601

	measure '% Receita em Risco' = DIVIDE([Receita em Risco], [Receita Total])
		formatString: 0.0%
		displayFolder: Risco
		lineageTag: 1f2a3b4c-5d6e-4f70-8a91-b2c3d4e5f602

	measure 'Retencao Cohort' = DIVIDE(SUM(fato_cohort[Clientes_Retidos]), SUM(fato_cohort[Tamanho_Safra]))
		formatString: 0.0%
		displayFolder: Cohort
		lineageTag: 1f2a3b4c-5d6e-4f70-8a91-b2c3d4e5f603

	column _
		lineageTag: 3eb17d00-8343-408f-9cbe-425e181f2951
		sourceColumn: [Value]

	partition _Saude = calculated
		mode: import
		source = { BLANK() }

