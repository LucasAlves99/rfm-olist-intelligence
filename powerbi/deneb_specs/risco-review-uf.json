{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "padding": 5,
  "width": "container",
  "height": "container",
  "title": {
    "text": "Previsão do modelo · % de pedidos com risco de nota baixa · linha = média BR",
    "fontSize": 9,
    "fontWeight": 400,
    "color": "#A6BBBC",
    "anchor": "start",
    "offset": 4
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "domain": false,
      "ticks": false,
      "gridColor": "rgba(255,255,255,0.06)",
      "labelColor": "#C6D6D7",
      "titleColor": "#8AA0A2",
      "labelFontSize": 10,
      "titleFontSize": 10
    },
    "legend": {
      "disable": true
    }
  },
  "data": {
    "name": "dataset"
  },
  "transform": [
    {
      "calculate": "datum['Pct_Alto_Risco']*datum['Pedidos']",
      "as": "hr"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "hr",
          "as": "sum_hr"
        },
        {
          "op": "sum",
          "field": "Pedidos",
          "as": "sum_ped"
        }
      ]
    },
    {
      "calculate": "datum.sum_hr/datum.sum_ped",
      "as": "media"
    },
    {
      "calculate": "'média BR · ' + format(datum.sum_hr/datum.sum_ped,'.1%')",
      "as": "media_lbl"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rk"
        }
      ],
      "sort": [
        {
          "field": "Pct_Alto_Risco",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rk <= 14"
    },
    {
      "calculate": "format(datum['Pct_Alto_Risco'], '.1%')",
      "as": "lbl"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "y": {
          "field": "UF",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Pct_Alto_Risco",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "Pct_Alto_Risco",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": ".0%",
            "grid": true
          }
        },
        "color": {
          "field": "Pct_Alto_Risco",
          "type": "quantitative",
          "scale": {
            "range": [
              "#79C9A4",
              "#E8879A"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "UF"
          },
          {
            "field": "Pct_Alto_Risco",
            "type": "quantitative",
            "format": ".1%"
          },
          {
            "field": "Pedidos",
            "type": "quantitative",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "datum.__selected__ === 'off'",
            "value": 0.25
          },
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "color": "#C6D6D7",
        "fontSize": 10
      },
      "encoding": {
        "y": {
          "field": "UF",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Pct_Alto_Risco",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "Pct_Alto_Risco",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "datum.__selected__ === 'off'",
            "value": 0.25
          },
          "value": 1
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rk == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#EAF2F2",
        "strokeDash": [
          3,
          3
        ],
        "opacity": 0.45
      },
      "encoding": {
        "x": {
          "field": "media",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rk == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 4,
        "fontSize": 8,
        "color": "#05080A",
        "stroke": "#05080A",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "media",
          "type": "quantitative"
        },
        "y": {
          "value": 3
        },
        "text": {
          "field": "media_lbl",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rk == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 4,
        "fontSize": 8,
        "color": "#DCE7E7"
      },
      "encoding": {
        "x": {
          "field": "media",
          "type": "quantitative"
        },
        "y": {
          "value": 3
        },
        "text": {
          "field": "media_lbl",
          "type": "nominal"
        }
      }
    }
  ]
}